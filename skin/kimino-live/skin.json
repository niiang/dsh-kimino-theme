    "live-wallpaper",
    "video"
  ],
  "accent": "#93C5FD",
  "order": 61,
  "license": "MIT (code) — artwork © CoMix Wave Films / Toho, personal desktop use only",
  "sourceUrl": "https://github.com/niiang/dsh-kimino-theme",
